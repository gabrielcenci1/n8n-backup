    {
      "parameters": {
        "jsCode": "const nomeCompleto = $('Dados').item.json.Nome;\n\n// Dividir o nome completo em nome e sobrenome\nconst partesNome = nomeCompleto.split(' ');\n\n// Determinar o nome e sobrenome\nconst nome = partesNome[0];\nconst sobrenome = partesNome.length > 1 ? partesNome.slice(1).join(' ') : '';\n\n// Criar o objeto de saída\nconst saida = {\n  nome: nome,\n  sobrenome: sobrenome\n};\n\n// Saída do resultado\nreturn saida;"
      },
