        "jsCode": "// Recebe o valor como entrada\nconst input = $('Dados').item.json.body.data.key.remoteJid;\n\n// Verifica se o valor está presente e é uma string\nif (input && typeof input === 'string') {\n  // Remove tudo após o \"@\" usando split e pega a primeira parte\n  const result = input.split('@')[0];\n\n  // Retorna o resultado\n  return {\n    output: result\n  };\n} else {\n  // Retorna uma mensagem de erro se o valor não for uma string\n  return {\n    error: ''\n  };\n}\n"
