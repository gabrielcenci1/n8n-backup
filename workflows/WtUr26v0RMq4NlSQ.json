    },
    {
      "parameters": {
        "jsCode": "const currentDate = new Date();\n\n// Obter o dia, mês e ano\nconst day = currentDate.getDate();\nconst month = currentDate.getMonth() + 1; // Os meses começam do zero, então adicionamos 1\nconst year = currentDate.getFullYear();\n\n// Formatar a data no formato desejado (dia/mês/ano)\nconst formattedDate = `${day}/${month}/${year}`;\n\n// Obter a hora e o minuto\nconst hour = currentDate.getHours();\nconst minute = currentDate.getMinutes();\n\n// Formatar a hora no formato desejado (hora:minuto)\nconst formattedTime = `${hour}:${minute}`;\n\n// Retornar a data e a hora separadas\nreturn { \n    data: formattedDate,\n    hora: formattedTime\n};\n"
      },
      "id": "f65030a6-b431-48da-9bd1-eb5ce176543e",
      "name": "Data",
